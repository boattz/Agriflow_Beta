# Agriflow — env example (no secrets; copy to .env for local dev)
PORT=10000
NODE_ENV=development
DATABASE_URL=postgresql://localhost:5432/postgres
RESET_TOKEN=

# LINE Messaging API (OA)
LINE_ENABLED=false
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
LINE_REG_CODE=AGRIFLOW-XXXX
LINE_OFFLINE_MIN=1
LINE_COOLDOWN_MIN=60
LINE_MIN_INTERVAL_MIN=3
# Quota-savers (free plan = 200 push/month): valve push defaults OFF, level ON
LINE_VALVE_ALERTS=false
LINE_LEVEL_ALERTS=true

# Sensor ingest auth (agriscan-style, optional — empty = open endpoint)
SENSOR_API_KEY=

# Auto-delete readings older than N days (cleanup every 50 inserts + at boot)
RETENTION_DAYS=30
